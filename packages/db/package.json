{
  "name": "@satarobo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push --force",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts",
    "apply-sql": "tsx src/apply-sql.ts",
    "test": "echo 'no tests in db'"
  },
  "dependencies": {
    "@satarobo/core": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
