# ---- Database (Postgres; Supabase hoặc local docker) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/satarobo

# ---- Giới hạn kết nối và thời gian chờ CSDL (xem docs/HIEU-NANG.md) ----
# Số kết nối MỖI TIẾN TRÌNH. Postgres mặc định chỉ có 100 kết nối, nên
# (số tiến trình web + worker) × DB_POOL_MAX phải nhỏ hơn con số đó.
DB_POOL_MAX=10
# Một câu truy vấn chạy quá lâu bị Postgres huỷ, không giữ kết nối làm cạn pool.
# Worker tự nới riêng lên 60s cho các việc quét định kỳ.
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_SEC=10
DB_IDLE_TIMEOUT_SEC=30

# ---- Đo hiệu năng ----
# Thủ tục tRPC chạy lâu hơn ngưỡng này (ms) sẽ ghi một dòng log:
# "slow-procedure path=… ms=… queries=… ok=…". Đặt 0 để ghi mọi thủ tục khi cần soi.
SLOW_PROCEDURE_MS=1000
# In nguyên văn câu SQL ra màn hình — CHỈ dùng ở máy dev
# DRIZZLE_LOG=1

# ---- Ngưỡng của /api/ready ----
# Vượt một trong hai ngưỡng thì /api/ready trả 503 (việc nền đang tồn đọng)
READY_OUTBOX_BACKLOG=1000
READY_OUTBOX_AGE_SEC=900

# ---- Worker ----
WORKER_INTERVAL_MS=10000

# ---- Supabase Auth (để trống khi dev: chọn tài khoản mẫu ở /login) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Địa chỉ công khai (liên kết trong email mời / đặt lại mật khẩu)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vai trò bắt buộc xác thực 2 lớp (mặc định SUPER_ADMIN)
REQUIRE_MFA_ROLES=SUPER_ADMIN

# ---- Dev bypass: đăng nhập giả bằng email có trong bảng users ----
# Bỏ chú thích dòng dưới CHỈ khi chạy máy cá nhân. Khi NODE_ENV=production biến này
# bị bỏ qua hoàn toàn (mã nguồn không còn cửa hậu bật lại).
# ALLOW_DEV_ACTOR=1

# ---- Legacy migration ----
LEGACY_DATABASE_URL=

# Webhook SePay (biến động số dư): đặt khoá bất kỳ đủ dài, khai báo cùng giá trị trên SePay
# (Xác thực: API Key → header "Authorization: Apikey <khoá>"), URL: https://<domain>/api/webhooks/sepay
SEPAY_API_KEY=

# ---- Bảo mật (BẮT BUỘC khi chạy thật; tạo bằng: openssl rand -base64 48) ----
# Thiếu các khoá này khi NODE_ENV=production thì ứng dụng báo lỗi ngay thay vì dùng khoá mẫu.
MEDIA_SIGNING_SECRET=
OTP_PEPPER=
CRON_SECRET=
# Khoá mã hoá CCCD / địa chỉ phụ huynh (parent_private); bỏ trống thì dùng MEDIA_SIGNING_SECRET
PII_ENCRYPTION_KEY=

# ---- Lưu trữ & sao lưu ----
# Đường dẫn tuyệt đối; thư mục này phải nằm trong kế hoạch sao lưu
STORAGE_DIR=
BACKUP_DIR=
APP_VERSION=

# ---- Website / form công khai ----
PUBLIC_FORM_ORIGINS=https://satarobo.vn

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM=Sata Robo <no-reply@satarobo.vn>

# ---- Facebook Messenger (webhook: https://<domain>/api/webhooks/messenger) ----
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
META_CAPI_TOKEN=

# ---- Zalo OA (webhook: https://<domain>/api/webhooks/zalo) ----
ZALO_APP_ID=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TOKEN=
