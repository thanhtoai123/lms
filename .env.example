# ---- Database (Postgres; Supabase hoặc local docker) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/satarobo

# ---- Supabase Auth (để trống khi dev với DEV_ACTOR_EMAIL) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Dev bypass: đăng nhập giả bằng email có trong bảng users. KHÔNG bật ở production ----
ALLOW_DEV_ACTOR=1
DEV_ACTOR_EMAIL=teacher1@satarobo.vn

# ---- Legacy migration ----
LEGACY_DATABASE_URL=
