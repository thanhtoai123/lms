# ---- Database (Postgres; Supabase hoặc local docker) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/satarobo

# ---- Supabase Auth (để trống khi dev: chọn tài khoản mẫu ở /login) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Dev bypass: đăng nhập giả bằng email có trong bảng users. KHÔNG bật ở production ----
ALLOW_DEV_ACTOR=1
# ALLOW_DEV_ACTOR=1 bật khối "tài khoản mẫu" trên /login (không bao giờ bật ở production)

# ---- Legacy migration ----
LEGACY_DATABASE_URL=

# Webhook SePay (biến động số dư): đặt khoá bất kỳ đủ dài, khai báo cùng giá trị trên SePay
# (Xác thực: API Key → header "Authorization: Apikey <khoá>"), URL: https://<domain>/api/webhooks/sepay
SEPAY_API_KEY=
