# ---- Database (Postgres; Supabase hoặc local docker) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/satarobo

# ---- Supabase Auth (để trống khi dev: chọn tài khoản mẫu ở /login) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Địa chỉ công khai (liên kết trong email mời / đặt lại mật khẩu)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vai trò bắt buộc xác thực 2 lớp (mặc định SUPER_ADMIN)
REQUIRE_MFA_ROLES=SUPER_ADMIN

# ---- Dev bypass: đăng nhập giả bằng email có trong bảng users. KHÔNG bật ở production ----
ALLOW_DEV_ACTOR=1
# ALLOW_DEV_ACTOR=1 bật khối "tài khoản mẫu" trên /login (không bao giờ bật ở production)

# ---- Legacy migration ----
LEGACY_DATABASE_URL=

# Webhook SePay (biến động số dư): đặt khoá bất kỳ đủ dài, khai báo cùng giá trị trên SePay
# (Xác thực: API Key → header "Authorization: Apikey <khoá>"), URL: https://<domain>/api/webhooks/sepay
SEPAY_API_KEY=

# ---- Bảo mật (BẮT BUỘC khi chạy thật; tạo bằng: openssl rand -base64 48) ----
MEDIA_SIGNING_SECRET=
OTP_PEPPER=
CRON_SECRET=
# Khoá mã hoá CCCD / địa chỉ phụ huynh (parent_private); bỏ trống thì dùng MEDIA_SIGNING_SECRET
PII_ENCRYPTION_KEY=

# ---- Lưu trữ & sao lưu ----
# Đường dẫn tuyệt đối; thư mục này phải nằm trong kế hoạch sao lưu
STORAGE_DIR=
BACKUP_DIR=
APP_VERSION=

# ---- Website / form công khai ----
PUBLIC_FORM_ORIGINS=https://satarobo.vn

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM=Sata Robo <no-reply@satarobo.vn>

# ---- Facebook Messenger (webhook: https://<domain>/api/webhooks/messenger) ----
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
META_CAPI_TOKEN=

# ---- Zalo OA (webhook: https://<domain>/api/webhooks/zalo) ----
ZALO_APP_ID=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TOKEN=
